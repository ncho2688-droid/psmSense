local function createSnowflake()
    local flake = Instance.new("Frame")
    flake.Size = UDim2.new(0, math.random(2, 5), 0, math.random(2, 5))
    flake.Position = UDim2.new(math.random(), 0, -0.05, 0)
    flake.BackgroundColor3 = Color3.fromRGB(230, 230, 255)
    flake.BackgroundTransparency = math.random(20, 50) / 100
    flake.BorderSizePixel = 0
    flake.Parent = SnowLayer
    Instance.new("UICorner", flake).CornerRadius = UDim.new(1, 0)
    table.insert(SnowParts, flake)

    local speed = math.random(12, 28) / 100
    local xMove = (math.random() - 0.5) * 0.1

    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not flake.Parent then conn:Disconnect() return end
        local pos = flake.Position
        local newY = pos.Y.Scale + speed * dt
        local newX = pos.X.Scale + xMove * dt
        if newY > 1.05 then
            flake.Position = UDim2.new(math.random(), 0, -0.05, 0)
        else
            flake.Position = UDim2.new(math.clamp(newX, -0.05, 1.05), 0, newY, 0)
        end
    end)
    table.insert(Connections, conn)
end

