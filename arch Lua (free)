local ESPPage = pages["ESP"]
local espSet

local function clearESP()
    for _, obj in pairs(ESPObjects) do
        pcall(function() if obj and obj.Parent then obj:Destroy() end end)
    end
    table.clear(ESPObjects)
end

local function createESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    local head = char:FindFirstChild("Head")
    if not hrp or not hum or not head then return end

    if S.ESP_Highlight then
        local hl = Instance.new("Highlight")
        hl.Name = "ArchESP"
        hl.FillColor = S.ESP_Rainbow and Color3.fromHSV(RainbowHue, 1, 1) or S.ESP_Color
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.55
        hl.OutlineTransparency = 0
        hl.Adornee = char
        hl.Parent = char
        table.insert(ESPObjects, hl)
    end

    local bill = Instance.new("BillboardGui")
    bill.Name = "ArchESP"
    bill.Adornee = head
    bill.Size = UDim2.new(0, 150, 0, 44)
    bill.StudsOffset = Vector3.new(0, 3.2, 0)
    bill.AlwaysOnTop = true
    bill.Parent = head
    table.insert(ESPObjects, bill)

    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1, 0, 0, 18)
    nameLabel.BackgroundTransparency = 1
    nameLabel.Text = player.DisplayName or player.Name
    nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nameLabel.TextStrokeTransparency = 0.3
    nameLabel.Font = Enum.Font.SourceSansBold
    nameLabel.TextSize = 15
    nameLabel.Visible = S.ESP_Name
    nameLabel.Parent = bill

    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1, 0, 0, 16)
    infoLabel.Position = UDim2.new(0, 0, 0, 18)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(180, 255, 180)
    infoLabel.TextStrokeTransparency = 0.3
    infoLabel.Font = Enum.Font.SourceSans
    infoLabel.TextSize = 13
    infoLabel.Parent = bill

    local conn = RunService.RenderStepped:Connect(function()
        if not char.Parent or not hrp or not hum then return end
        local dist = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude)
        local hp = math.floor(hum.Health)
        local txt = ""
        if S.ESP_Health then txt = txt .. hp .. "HP  " end
        if S.ESP_Distance then txt = txt .. dist .. "m" end
        infoLabel.Text = txt
        infoLabel.Visible = S.ESP_Health or S.ESP_Distance
    end)
    table.insert(Connections, conn)
end

local function refreshESP()
    clearESP()
    if not S.ESP then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        task.spawn(createESP, plr)
    end
end

