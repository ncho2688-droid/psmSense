    minus.Position = UDim2.new(1, -64, 0, 2)
    minus.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    minus.Text = "-"
    minus.TextColor3 = Color3.fromRGB(255, 255, 255)
    minus.Font = Enum.Font.SourceSansBold
    minus.TextSize = 15
    minus.Parent = frame
    Instance.new("UICorner", minus).CornerRadius = UDim.new(0, 4)

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0, 28, 0, 24)
    plus.Position = UDim2.new(1, -32, 0, 2)
    plus.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
    plus.Text = "+"
    plus.TextColor3 = Color3.fromRGB(255, 255, 255)
    plus.Font = Enum.Font.SourceSansBold
    plus.TextSize = 15
    plus.Parent = frame
    Instance.new("UICorner", plus).CornerRadius = UDim.new(0, 4)

