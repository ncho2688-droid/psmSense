UserInputService.InputBegan:Connect(function(input, gp)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if S.WaitingFeatureKey then
        S.WaitingFeatureKey(input.KeyCode)
        S.WaitingFeatureKey = nil
        return
    end

    if gp then return end

    if input.KeyCode == S.ToggleKey then
        S.UIVisible = not S.UIVisible
        Window.Visible = S.UIVisible
        updateToggleVisual()
    end

    if input.KeyCode == S.Key_Fly then
        S.Fly = not S.Fly
        if flySet then flySet(S.Fly) end
        local char = LocalPlayer.Character
        if char then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if hrp and hum then
                if S.Fly then
                    FlyBV = Instance.new("BodyVelocity")
                    FlyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    FlyBV.Parent = hrp
                    FlyBG = Instance.new("BodyGyro")
                    FlyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
                    FlyBG.P = 9e4
                    FlyBG.Parent = hrp
                    hum.PlatformStand = true
                else
                    if FlyBV then FlyBV:Destroy() FlyBV = nil end
                    if FlyBG then FlyBG:Destroy() FlyBG = nil end
                    hum.PlatformStand = false
                end
            end
        end
    end

    if input.KeyCode == S.Key_Noclip then
        S.Noclip = not S.Noclip
        if noclipSet then noclipSet(S.Noclip) end
    end

    if input.KeyCode == S.Key_Speed then
        S.Speed = not S.Speed
        if speedSet then speedSet(S.Speed) end
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = S.Speed and S.SpeedValue or 16 end
    end

    if input.KeyCode == S.Key_ESP then
        S.ESP = not S.ESP
        if espSet then espSet(S.ESP) end
        refreshESP()
    end

    if input.KeyCode == S.Key_ClickTP then
        S.ClickTP = not S.ClickTP
        if clickSet then clickSet(S.ClickTP) end
    end

    if input.KeyCode == S.Key_Aimbot then
        S.Aimbot = not S.Aimbot
        if aimbotSet then aimbotSet(S.Aimbot) end
    end

    if S.InfJump and input.KeyCode == Enum.KeyCode.Space then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end

    if S.LongJump and input.KeyCode == Enum.KeyCode.Space then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            hrp.Velocity = hrp.CFrame.LookVector * 80 + Vector3.new(0, 40, 0)
        end
    end
end)

