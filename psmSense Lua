-- ========== HEAD RING (hollow - segments) ==========
local function setupRing(char)
    for _, p in pairs(RingParts) do pcall(function() p:Destroy() end) end
    table.clear(RingParts)

    local head = char and char:FindFirstChild("Head")
    if not head then return end

    local segments = 16
    local radius = 1.15
    local folder = Instance.new("Folder")
    folder.Name = "psmRing"
    folder.Parent = char
    table.insert(RingParts, folder)

    for i = 1, segments do
        local angle = (i / segments) * math.pi * 2
        local seg = Instance.new("Part")
        seg.Name = "RingSeg"
        seg.Size = Vector3.new(0.12, 0.12, 0.35)
        seg.Color = dynamicColor
        seg.Material = Enum.Material.Neon
        seg.Transparency = 0.15
        seg.CanCollide = false
        seg.Massless = true
        seg.Parent = folder

        local weld = Instance.new("Weld")
        weld.Part0 = head
        weld.Part1 = seg
        local x = math.cos(angle) * radius
        local z = math.sin(angle) * radius
        weld.C0 = CFrame.new(x, 1.55, z) * CFrame.Angles(0, -angle, 0)
        weld.Parent = seg

        table.insert(RingParts, seg)
    end
end

local function setupSparkle(char)
    if SparkleAtt then pcall(function() SparkleAtt:Destroy() end) end
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local att = Instance.new("Attachment")
    att.Parent = root
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = "rbxassetid://243660364"
    pe.Color = ColorSequence.new(dynamicColor)
    pe.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.12),
        NumberSequenceKeypoint.new(1, 0)
    })
    pe.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.25),
        NumberSequenceKeypoint.new(1, 1)
    })
    pe.Lifetime = NumberRange.new(0.5, 1)
    pe.Rate = 20
    pe.Speed = NumberRange.new(1, 2.5)
    pe.SpreadAngle = Vector2.new(360, 360)
    pe.LightEmission = 1
    pe.Parent = att
    SparkleAtt = att
end

local function updateLocalEffects()
    local char = Client.Character
    if not char then return end

    local col = getActiveColor(Flags.Local_Rainbow)

    if Flags.Local_Ring then
        if #RingParts == 0 then setupRing(char) end
        for _, p in pairs(RingParts) do
            if p:IsA("BasePart") then
                p.Color = col
            end
        end
    else
        for _, p in pairs(RingParts) do pcall(function() p:Destroy() end) end
        table.clear(RingParts)
    end

    if Flags.Local_Sparkle then
        if not SparkleAtt or not SparkleAtt.Parent then setupSparkle(char) end
        if SparkleAtt then
            local pe = SparkleAtt:FindFirstChildOfClass("ParticleEmitter")
            if pe then pe.Color = ColorSequence.new(col) end
        end
    else
        if SparkleAtt then pcall(function() SparkleAtt:Destroy() end) SparkleAtt = nil end
    end
end

table.insert(Connections, Client.CharacterAdded:Connect(function()
    task.wait(0.5)
    clearLocalEffects()
    updateLocalEffects()
end))

-- ESP
local function MakeDraw(class, props)
    if not DrawingLib then return nil end
    local ok, d = pcall(function() return DrawingLib.new(class) end)
    if not ok or not d then return nil end
    for k, v in pairs(props or {}) do pcall(function() d[k] = v end) end
    return d
end

local function CreateESP(plr)
    if plr == Client or not DrawingLib then return end
    ESPObjects[plr] = {
        Box = MakeDraw("Square", {Thickness = 1, Filled = false, Visible = false}),
        Outline = MakeDraw("Square", {Thickness = 2, Filled = false, Color = Color3.new(0,0,0), Visible = false}),
        Name = MakeDraw("Text", {Size = 13, Center = true, Outline = true, Visible = false}),
        Health = MakeDraw("Square", {Filled = true, Visible = false}),
        HealthOut = MakeDraw("Square", {Thickness = 1, Filled = false, Color = Color3.new(0,0,0), Visible = false}),
        Dist = MakeDraw("Text", {Size = 12, Center = true, Outline = true, Visible = false}),
    }
end

local function RemoveESP(plr)
    local d = ESPObjects[plr]
    if not d then return end
    for _, v in pairs(d) do
        if v and v.Remove then pcall(function() v:Remove() end) end
    end
    ESPObjects[plr] = nil
end

local function UpdateESP()
    if not running or not Flags.ESP_Enabled or not DrawingLib then
        for _, d in pairs(ESPObjects) do
            for _, v in pairs(d) do if v then v.Visible = false end end
        end
        return
    end

    local col = getActiveColor(Flags.ESP_Rainbow)

    for _, plr in pairs(Players:GetPlayers()) do
        if plr == Client then continue end
        if not ESPObjects[plr] then CreateESP(plr) end
        local d = ESPObjects[plr]
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        if not char or not hum or not root or hum.Health <= 0 then
            for _, v in pairs(d) do if v then v.Visible = false end end
            continue
        end
        if Flags.ESP_TeamCheck and plr.Team and Client.Team and plr.Team == Client.Team then
            for _, v in pairs(d) do if v then v.Visible = false end end
            continue
        end

        local pos, on = Camera:WorldToViewportPoint(root.Position)
        if not on then
            for _, v in pairs(d) do if v then v.Visible = false end end
            continue
        end

        local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local footPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))
        local sizeY = math.abs(headPos.Y - footPos.Y)
        local sizeX = sizeY / 1.6
        local boxPos = Vector2.new(pos.X - sizeX/2, headPos.Y)
        local dist = (root.Position - Camera.CFrame.Position).Magnitude

        if Flags.ESP_Box and d.Box then
            d.Box.Visible = true
            d.Outline.Visible = true
            d.Box.Color = col
            d.Box.Size = Vector2.new(sizeX, sizeY)
            d.Box.Position = boxPos
            d.Outline.Size = Vector2.new(sizeX, sizeY)
            d.Outline.Position = boxPos
        else
            if d.Box then d.Box.Visible = false end
            if d.Outline then d.Outline.Visible = false end
        end

        if Flags.ESP_Name and d.Name then
            d.Name.Visible = true
            d.Name.Text = plr.Name
            d.Name.Color = col
            d.Name.Position = Vector2.new(pos.X, headPos.Y - 15)
        elseif d.Name then d.Name.Visible = false end

        if Flags.ESP_Health and d.Health then
            local h = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            d.Health.Visible = true
            d.HealthOut.Visible = true
            d.Health.Color = Color3.fromRGB(255*(1-h), 255*h, 0)
            d.Health.Size = Vector2.new(3, sizeY * h)
            d.Health.Position = Vector2.new(boxPos.X - 6, boxPos.Y + sizeY - sizeY*h)
            d.HealthOut.Size = Vector2.new(3, sizeY)
            d.HealthOut.Position = Vector2.new(boxPos.X - 6, boxPos.Y)
        else
            if d.Health then d.Health.Visible = false end
            if d.HealthOut then d.HealthOut.Visible = false end
        end

        if Flags.ESP_Distance and d.Dist then
            d.Dist.Visible = true
            d.Dist.Text = math.floor(dist) .. "m"
            d.Dist.Color = col
            d.Dist.Position = Vector2.new(pos.X, footPos.Y + 2)
        elseif d.Dist then d.Dist.Visible = false end
    end
end

table.insert(Connections, Players.PlayerAdded:Connect(function(p) CreateESP(p) end))
table.insert(Connections, Players.PlayerRemoving:Connect(function(p) RemoveESP(p) end))
for _, p in pairs(Players:GetPlayers()) do if p ~= Client then CreateESP(p) end end

table.insert(Connections, RunService.RenderStepped:Connect(function(dt)
    if not running then return end

    -- animated color
    rainbowHue = (rainbowHue + dt * (Flags.Rainbow_Speed or 0.3)) % 1
    if Flags.ESP_Rainbow or Flags.Local_Rainbow then
        dynamicColor = Color3.fromHSV(rainbowHue, 0.9, 1)
    else
        dynamicColor = Color3.fromHSV(Flags.Color_H or 0.55, Flags.Color_S or 1, Flags.Color_V or 1)
    end

    -- update preview if exists
    for _, c in pairs(content:GetChildren()) do
        local prev = c:FindFirstChild("ColorPreview")
        if prev then prev.BackgroundColor3 = dynamicColor end
    end

    pcall(UpdateESP)
    pcall(updateLocalEffects)

    local stretch = math.clamp(Flags.World_Stretch or 1, 0.1, 3)
    Camera.FieldOfView = baseFOV / stretch

    if Flags.World_Fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 9e9
        Lighting.GlobalShadows = false
    else
        if Flags.World_NoFog then Lighting.FogEnd = 9e9 end
    end
end))

