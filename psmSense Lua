local function createSnowflake()
    local flake = Instance.new("Frame")
    flake.Size = UDim2.new(0, math.random(2, 4), 0, math.random(2, 4))
    flake.Position = UDim2.new(math.random(), 0, -0.05, 0)
    flake.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    flake.BackgroundTransparency = math.random(35, 65) / 100
    flake.BorderSizePixel = 0
    flake.Parent = snowFolder
    Instance.new("UICorner", flake).CornerRadius = UDim.new(1, 0)

    local speed = math.random(15, 30) / 10
    local xMove = (math.random() - 0.5) * 0.12
    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not flake.Parent then conn:Disconnect() return end
        local y = flake.Position.Y.Scale + dt * speed * 0.035
        local x = flake.Position.X.Scale + dt * xMove
        if y > 1.05 then flake:Destroy() conn:Disconnect() return end
        flake.Position = UDim2.new(x, 0, y, 0)
    end)
end

task.spawn(function()
    while main.Parent do
        if #snowFolder:GetChildren() < 40 then createSnowflake() end
